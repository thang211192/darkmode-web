{
  "manifest_version": 3,
  "name": "Luna — Dark mode cho mọi website",
  "version": "1.0.2",
  "description": "Không gian web dịu mắt. Chỉnh độ tối, bật tắt từng website và quản lý danh sách ngoại lệ.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Luna · Dark mode"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [
    {"matches": ["http://*/*", "https://*/*"], "js": ["vendor/page-proxy.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true, "match_about_blank": true},
    {"matches": ["http://*/*", "https://*/*"], "js": ["bridge.js", "vendor/darkreader.js", "shared.js", "content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}
  ],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
